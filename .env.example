# ─── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key

# ─── Twitter / X ─────────────────────────────────────────────────────────────
TWITTER_BEARER_TOKEN=your-bearer-token
TWITTER_QUERY=#CITYHamirpur -is:retweet

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5500
